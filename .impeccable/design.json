      "html": "<button class=\"ds-btn-sec\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg>Na minha lista</button>",
      "css": ".ds-btn-sec{font-family:Archivo,system-ui,sans-serif;font-size:15.5px;font-weight:750;min-height:50px;padding:0 14px;border-radius:12px;border:1.5px solid #17163a;background:transparent;color:#17163a;display:inline-flex;align-items:center;gap:7px;cursor:pointer;transition:background .15s,transform .12s}.ds-btn-sec svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}.ds-btn-sec:hover{background:#eeedf6}.ds-btn-sec:active{transform:scale(.98)}.ds-btn-sec:focus-visible{outline:2px solid #cc3366;outline-offset:2px}"
    },
    {
      "name": "Busca na faixa marinho",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Campo de busca sobre o cabeçalho marinho com fio dourado.",
      "html": "<div class=\"ds-head\"><div class=\"ds-search\"><input placeholder=\"Loja, produto ou número do box\" aria-label=\"Buscar\"><svg viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg></div></div>",
      "css": ".ds-head{background:#16163f;padding:10px 12px;border-bottom:2px solid #ffc233}.ds-search{position:relative}.ds-search input{width:100%;box-sizing:border-box;height:46px;font-family:Archivo,system-ui,sans-serif;font-size:16px;font-weight:550;padding:0 44px;border-radius:12px;border:2px solid transparent;background:#fff;color:#17163a;outline:none;caret-color:#cc3366;transition:border-color .15s}.ds-search input::placeholder{color:#58567c}.ds-search input:focus{border-color:#ffc233}.ds-search svg{position:absolute;left:13px;top:12px;width:22px;height:22px;color:#58567c;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;pointer-events:none}.ds-search:focus-within svg{color:#cc3366}"
    },
    {
      "name": "Abas de prédio·piso",
      "kind": "nav",
      "refersTo": "floor-tab",
      "description": "Sumário de catálogo com fio rosa sob a aba ativa.",
      "html": "<nav class=\"ds-tabs\"><button class=\"on\">Shopping · Térreo</button><button>Shopping · Piso 1</button><i></i><button>Park · Térreo</button></nav>",
      "css": ".ds-tabs{display:flex;gap:2px;padding:0 8px;background:#fff;border-bottom:1px solid #dcdaea}.ds-tabs button{font-family:Archivo,system-ui,sans-serif;font-size:13.5px;font-weight:700;font-stretch:85%;padding:12px 10px 10px;color:#58567c;background:none;border:0;border-bottom:3px solid transparent;cursor:pointer;white-space:nowrap;transition:color .15s,border-color .15s}.ds-tabs button:hover{color:#17163a}.ds-tabs button.on{color:#17163a;border-bottom-color:#cc3366}.ds-tabs button:focus-visible{outline:2px solid #cc3366;outline-offset:2px}.ds-tabs i{width:1px;background:#dcdaea;margin:10px 6px}"
    },
    {
      "name": "Chip de segmento",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Filtro por segmento; ligado inverte para tinta.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip on\">Feminino</button><button class=\"ds-chip\">Jeans</button></div>",
      "css": ".ds-chips{display:flex;gap:6px}.ds-chip{height:36px;padding:0 12px;border-radius:999px;border:1px solid #dcdaea;background:#fff;color:#17163a;font-family:Archivo,system-ui,sans-serif;font-size:13.5px;font-weight:700;cursor:pointer;transition:background .15s,border-color .15s,color .15s}.ds-chip:hover{border-color:#58567c}.ds-chip.on{background:#17163a;border-color:#17163a;color:#fff}.ds-chip:focus-visible{outline:2px solid #cc3366;outline-offset:2px}"
    },
    {
      "name": "Linha do índice REF",
      "kind": "custom",
      "refersTo": "ref-tag",
      "description": "Assinatura do índice: REF dourado tabular, nome, meta com tira de segmento, distância e adicionar.",
      "html": "<div class=\"ds-item\"><span class=\"ds-ref\">VM 89</span><div class=\"ds-mid\"><div class=\"ds-n\">Violeta Jeans</div><div class=\"ds-l\"><i style=\"background:#2f3d8f\"></i>Jeans · Shopping · Térreo</div></div><span class=\"ds-dist\">~20 m</span><button class=\"ds-add\" aria-label=\"Adicionar à lista\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg></button></div>",
      "css": ".ds-item{display:flex;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid #dcdaea;font-family:Archivo,system-ui,sans-serif;cursor:pointer;transition:background .15s}.ds-item:hover{background:#f4f3f9}.ds-ref{width:64px;flex:none;font-size:18px;font-weight:850;font-stretch:72%;letter-spacing:.01em;color:#7a5200;font-variant-numeric:tabular-nums lining-nums}.ds-mid{flex:1;min-width:0}.ds-n{font-weight:750;font-size:15.5px;line-height:1.25;color:#17163a}.ds-l{font-size:13px;color:#58567c;margin-top:3px;display:flex;gap:6px;align-items:center}.ds-l i{width:14px;height:4px;border-radius:1px}.ds-dist{font-size:14px;font-weight:750;font-stretch:85%;color:#17163a;font-variant-numeric:tabular-nums}.ds-add{width:40px;height:40px;border-radius:10px;border:1.5px solid #dcdaea;background:transparent;color:#cc3366;display:grid;place-items:center;cursor:pointer;transition:border-color .15s}.ds-add:hover{border-color:#cc3366}.ds-add:focus-visible{outline:2px solid #cc3366;outline-offset:2px}.ds-add svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Legenda de catálogo",
      "kind": "custom",
      "refersTo": "ref-tag",
      "description": "Assinatura do mapa: linha fina da loja escolhida até REF + nome.",
      "html": "<svg class=\"ds-lg\" viewBox=\"0 0 260 110\"><rect x=\"8\" y=\"70\" width=\"44\" height=\"32\" rx=\"6\" fill=\"#ffe4ee\" stroke=\"#cc3366\" stroke-width=\"2.4\"/><rect x=\"8\" y=\"70\" width=\"44\" height=\"4\" rx=\"2\" fill=\"#2f3d8f\"/><path class=\"ln\" d=\"M30 86L60 46H230\"/><circle class=\"pt\" cx=\"30\" cy=\"86\" r=\"4.5\"/><text class=\"rf\" x=\"62\" y=\"22\">VM 89</text><text class=\"nm\" x=\"62\" y=\"40\">Violeta Jeans</text></svg>",
      "css": ".ds-lg{width:260px;height:110px;background:#f6f5fa;font-family:Archivo,system-ui,sans-serif;}.ds-lg .ln{stroke:#17163a;stroke-width:1.2;fill:none}.ds-lg .pt{fill:#cc3366;stroke:#f6f5fa;stroke-width:2}.ds-lg .rf{fill:#7a5200;font-size:13px;font-weight:850;font-stretch:72%;letter-spacing:.02em}.ds-lg .nm{fill:#17163a;font-size:17px;font-weight:850;font-stretch:72%}.ds-lg text{paint-order:stroke;stroke:#f6f5fa;stroke-width:4px;stroke-linejoin:round}"
    },
    {
      "name": "Passos medidos",
      "kind": "custom",
      "refersTo": "",
      "description": "Passo a passo com barra proporcional aos metros de cada trecho.",
      "html": "<ol class=\"ds-steps\"><li><span>Siga pela Via Mega por ~40 m</span><span class=\"m\"><i style=\"width:100%\"></i></span></li><li><span>Vire à direita na Via Central, ~15 m</span><span class=\"m\"><i style=\"width:38%\"></i></span></li></ol>",
      "css": ".ds-steps{list-style:none;margin:0;padding:0;counter-reset:p;font-family:Archivo,system-ui,sans-serif;color:#17163a}.ds-steps li{counter-increment:p;display:grid;grid-template-columns:26px 1fr;column-gap:8px;padding:9px 0;border-bottom:1px solid #dcdaea;font-size:14.5px;line-height:1.45}.ds-steps li:last-child{border-bottom:0}.ds-steps li:before{content:counter(p);font-weight:850;font-stretch:72%;font-size:15px;color:#58567c;font-variant-numeric:tabular-nums}.ds-steps .m{grid-column:2;display:block;height:4px;margin-top:7px;border-radius:2px;background:#eeedf6;overflow:hidden}.ds-steps .m i{display:block;height:100%;background:#2b2860;border-radius:2px}"
    },
